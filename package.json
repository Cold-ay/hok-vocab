{
  "name": "hok-vocab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:sync:all": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync:ios && npx cap open ios",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify": "npm run lint && npm test && npm run release:check",
    "release:check": "node scripts/check-release.mjs",
    "release:android": "node scripts/release.mjs android",
    "release:android:unsigned": "node scripts/release.mjs android --unsigned",
    "release:ios": "node scripts/release.mjs ios",
    "release:ios:unsigned": "node scripts/release.mjs ios --unsigned",
    "cap:sync:ios": "npm run build && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
